# Copy to .env.local and fill in. (DATABASE_URL also goes in .env for Prisma CLI.)

# Database — SQLite locally; a Postgres URL in production.
DATABASE_URL="file:./dev.db"

# Auth — session signing secret. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Groq (AI generation) — https://console.groq.com  (key starts with gsk_)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Slack incoming webhook (optional) — enables the "Post to Slack" button
SLACK_WEBHOOK_URL=

# GitHub token (optional) — only for private repos / higher rate limits
GITHUB_TOKEN=
