// GitStand data model. SQLite for zero-setup local dev; switch `provider` to
// "postgresql" and point DATABASE_URL at a hosted Postgres for production.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Company {
  id              String   @id @default(cuid())
  domain          String   @unique // e.g. "acme.com" — derived from member emails
  name            String
  slackWebhookURL String? // shared team channel
  createdAt       DateTime @default(now())
  users           User[]
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  name            String?
  role            String    @default("member") // "admin" can set the company channel
  slackWebhookURL String? // personal override; takes precedence over company
  companyId       String?
  company         Company?  @relation(fields: [companyId], references: [id])
  createdAt       DateTime  @default(now())
  standups        Standup[]

  @@index([companyId])
}

model Standup {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  format        String   @default("bullets")
  rawInput      String   @default("")
  generatedJson String // serialized { yesterday, today, blockers }

  @@index([userId])
}
